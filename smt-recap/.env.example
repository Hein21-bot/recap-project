# Google Gemini API Key (REQUIRED — used for both script + audio)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (OPTIONAL — only needed as fallback if Gemini TTS fails)
# Get from: https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default Voice (Gemini TTS voices: Sadaltager, Charon, Puck, Kore)
DEFAULT_VOICE_NAME=Sadaltager

# Video Settings
INPUT_VIDEO_PATH=./input/video.mp4
OUTPUT_DIR=./output

# Pipeline Settings
TARGET_DURATION_SECONDS=60
MIN_WORD_COUNT=180
MAX_WORD_COUNT=200
AUDIO_SPEED=1.15
